#!/bin/sh
# bootorder-guard — keep Limine first in the UEFI boot order. A Windows feature update
# puts Windows Boot Manager back in front; a firmware reset can drop the entry altogether
# (then limine-install registers it again). Also puts Limine's look back (limine-look).
# Run at every boot by
# boot-void-bootorder.service (dotfiles/system/boot-void.sh).
# Limine's look, should a write have slipped past the post hook
[ -x /usr/local/lib/boot-void/limine-look ] && /usr/local/lib/boot-void/limine-look
command -v efibootmgr >/dev/null || exit 0
# the Limine entry by what it loads, whatever it's called (boot-void.sh --label renames it)
find_lim() { printf '%s\n' "$1" | grep -iF '\EFI\limine\limine_x64.efi' | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\).*/\1/p' | head -1; }
list=$(efibootmgr) || exit 0
lim=$(find_lim "$list")
if [ -z "$lim" ]; then
    echo "no Limine boot entry: registering it again"
    limine-install >/dev/null 2>&1 || exit 1
    list=$(efibootmgr)
    lim=$(find_lim "$list")
    [ -n "$lim" ] || exit 1
fi
order=$(printf '%s\n' "$list" | sed -n 's/^BootOrder: *//p')
[ "${order%%,*}" = "$lim" ] && exit 0
rest=$(printf '%s\n' "$order" | tr ',' '\n' | grep -vix "$lim" | paste -sd, -)
efibootmgr -o "$lim${rest:+,$rest}" >/dev/null && echo "Limine back in front (boot order was $order)"
